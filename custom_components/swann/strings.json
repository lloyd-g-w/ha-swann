{
  "config": {
    "step": {
      "user": {
        "title": "Swann NVR",
        "description": "Connect to a Swann NVR (RaySharp firmware) on your local network.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "use_https": "Use HTTPS",
          "verify_ssl": "[%key:common::config_flow::data::verify_ssl%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "data_description": {
          "host": "Hostname or IP address of the NVR.",
          "port": "Port of the NVR web interface.",
          "verify_ssl": "NVRs usually use a self-signed certificate; leave off unless you installed a trusted one."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Swann NVR",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "wrong_device": "The credentials belong to a different NVR."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Swann NVR options",
        "data": {
          "stream_type": "Camera stream",
          "scan_interval": "Polling interval (seconds)",
          "manage_servers": "Also manage DDNS and cloud upload servers (experimental)"
        },
        "data_description": {
          "manage_servers": "Lets the Swann cloud switch also turn off DDNS and the Swann/Dropbox/Google Drive/AWS upload servers. Untested: the NVR may clear their saved passwords when these settings are written."
        }
      }
    }
  },
  "selector": {
    "stream_type": {
      "options": {
        "main": "Main stream (high resolution)",
        "sub": "Sub stream (low resolution)"
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "person": {
        "name": "Person"
      },
      "vehicle": {
        "name": "Vehicle"
      }
    },
    "switch": {
      "motion_detection": {
        "name": "Motion detection"
      },
      "cloud": {
        "name": "Swann cloud"
      }
    }
  },
  "exceptions": {
    "command_failed": {
      "message": "NVR command failed: {error}"
    },
    "no_saved_cloud_settings": {
      "message": "No saved cloud settings to restore. Re-enable cloud features in the NVR or Swann app."
    }
  }
}
